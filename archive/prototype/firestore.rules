rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isRecruiter() {
      return isAuthenticated() && request.auth.token.role == "corporate_recruiter";
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || !exists(/databases/$(database)/documents/users/$(userId));
    }

    // Readiness Scores Collection
    match /readiness_scores/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Mock Interviews Collection
    match /mock_interviews/{interviewId} {
      allow read: if isAuthenticated() && (resource.data.studentUid == request.auth.uid || isRecruiter());
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.studentUid == request.auth.uid;
    }

    // Placement Drives Collection
    match /placement_drives/{driveId} {
      allow read: if true; // Publicly viewable by verified students
      allow write: if isRecruiter();
    }
  }
}
